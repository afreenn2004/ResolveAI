generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agreement {
  id            String   @id @default(cuid())
  title         String
  buyerName     String
  sellerName    String
  totalAmount   Int
  currency      String   @default("USD")
  version       Int      @default(1)
  auditSequence Int      @default(0)
  captureInProgress Boolean @default(false)
  agreementHash String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  milestones        Milestone[]
  auditEvents       AuditEvent[]
  authorizations    PaymentAuthorization[]
  paymentOperations PaymentOperation[]
}

model Milestone {
  id                String    @id @default(cuid())
  agreementId       String
  agreement         Agreement @relation(fields: [agreementId], references: [id])
  title             String
  description       String
  amount            Int
  sequence          Int
  status            String    @default("PENDING")
  evidenceValidated Boolean   @default(false)
  buyerAcceptedAt   DateTime?
  capturedAmount    Int       @default(0)
  capturedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  auditEvents         AuditEvent[]
  paymentOperations   PaymentOperation[]
  evidenceSubmissions EvidenceSubmission[]

  @@unique([agreementId, sequence])
}

model AuditEvent {
  id           String     @id @default(cuid())
  agreementId  String
  agreement    Agreement  @relation(fields: [agreementId], references: [id])
  milestoneId  String?
  milestone    Milestone? @relation(fields: [milestoneId], references: [id])
  eventType    String
  details      String
  previousHash String?
  eventHash    String
  sequence     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([agreementId, sequence])
  @@index([agreementId, createdAt])
}

model PaymentAuthorization {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  paypalOrderId         String  @unique
  paypalAuthorizationId String? @unique

  amount              Int
  currency            String @default("USD")
  orderStatus         String
  authorizationStatus String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations PaymentOperation[]

  @@index([agreementId, createdAt])
}

model PaymentOperation {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  authorizationId String
  authorization   PaymentAuthorization @relation(fields: [authorizationId], references: [id])

  operationType String
  amount        Int
  currency      String @default("USD")
  status        String @default("PENDING")

  idempotencyKey  String  @unique
  paypalRequestId String  @unique
  paypalCaptureId String? @unique

  requestDetails  String?
  responseDetails String?
  failureReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agreementId, createdAt])
  @@index([milestoneId])
  @@index([authorizationId])
}

model EvidenceSubmission {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  submittedBy String @default("SELLER_AGENT")
  content     String
  contentHash String
  status      String @default("SUBMITTED")

  createdAt DateTime @default(now())

  validations EvidenceValidation[]

  @@index([milestoneId, createdAt])
  @@index([milestoneId, contentHash])
}

model EvidenceValidation {
  id           String             @id @default(cuid())
  submissionId String
  submission   EvidenceSubmission @relation(fields: [submissionId], references: [id])

  status           String
  results          String
  validatorVersion String

  createdAt DateTime @default(now())

  @@index([submissionId, createdAt])
}
